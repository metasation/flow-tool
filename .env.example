# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env lên git.
# Lấy token tại https://useapi.net — $15/tháng, bao 3 tài khoản Google.
USEAPI_TOKEN=your_useapi_token_here
# Email tài khoản Google Flow đã join family Ultra (tài khoản sẽ bị trừ credit).
# Dùng đúng email này, đừng dùng email khác — credit pool là của family này.
FLOW_EMAIL=you@gmail.com
