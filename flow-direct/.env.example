# flow-direct — KHÔNG bắt buộc. Chỉ điền khi cần.
# KHÔNG có USEAPI_TOKEN, KHÔNG có GEMINI_API_KEY ở đây.

# Email Flow của bạn (để kiểm tra đúng tài khoản) — tùy chọn
FLOW_EMAIL=you@gmail.com

# Tên project trong Flow muốn gen vào — bỏ trống = project hiện tại
FLOW_PROJECT=Dieu Pho

# Số phút chờ bạn giải captcha tay trong trình duyệt (mặc định 10)
CAPTCHA_WAIT_MIN=10

# --- Tùy chọn, tốn tiền, mặc định KHÔNG dùng ---
# Key giải captcha trả phí (2captcha / CapSolver). Chỉ thử với reCAPTCHA v2.
# Với Flow v3 vô hình thường KHÔNG có tác dụng — đừng kỳ vọng.
# TWO_CAPTCHA_API_KEY=...
# CAPSOLVER_API_KEY=...
